# ─── Supabase ───────────────────────────────────────────────────────────────
# Encontradas en: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# SERVICE ROLE KEY — NUNCA en el cliente, solo en server actions / API routes
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── URL del sitio ─────────────────────────────────────────────────────────
# En desarrollo: http://localhost:3000
# En producción: https://portal.laboratoriosbios.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google OAuth ──────────────────────────────────────────────────────────
# Configurar en: Supabase Dashboard → Authentication → Providers → Google
# El Client ID y Secret se configuran SOLO en Supabase, no se necesitan aquí.
# Solo asegúrate de agregar la URL de callback en Google Cloud Console:
# https://<tu-proyecto>.supabase.co/auth/v1/callback

# ─── Cloudflare Turnstile (CAPTCHA) ────────────────────────────────────────
# Obtener en: https://developers.cloudflare.com/turnstile/
# 1. Crear un sitio en Cloudflare Turnstile Dashboard
# 2. Configurar en: Supabase Dashboard → Authentication → Settings → Enable CAPTCHA protection
# 3. Pegar el Site Key en Supabase Y aquí
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>

# ─── Storage ───────────────────────────────────────────────────────────────
STORAGE_BUCKET_RESULTS=medical-results

# ─── Expiración de links de consulta (en segundos) ─────────────────────────
# Default: 2592000 = 30 días
RESULT_LINK_EXPIRY_SECONDS=2592000
